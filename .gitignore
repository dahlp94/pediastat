# Secrets — never commit a real environment file
.env

# Virtual environments
.venv/
venv/
env/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Downloaded raw data and derived analysis datasets
data/raw/*
!data/raw/.gitkeep

# Do not commit downloaded GDC files if they land under artifacts
artifacts/**/*.xlsx
artifacts/**/*.xls
artifacts/**/*.tsv
artifacts/**/*.txt.gz
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Local YAML settings (keep the committed example)
config/settings.yaml

# R session artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Quarto / report artifacts
reports/**/*.html
reports/**/*.pdf
reports/**/*_files/
/_freeze/
*.quarto_ipynb
