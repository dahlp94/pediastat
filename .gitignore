# Secrets — never commit a real environment file
.env

# Virtual environments
.venv/
venv/
env/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local PostgreSQL cluster
.pgdata/

# Downloaded raw data and derived analysis datasets
data/raw/*
!data/raw/.gitkeep

# Do not commit downloaded GDC files if they land under artifacts
artifacts/**/*.xlsx
artifacts/**/*.xls
artifacts/**/*.tsv
artifacts/**/*.txt.gz

# Interim data
data/interim/*
!data/interim/.gitkeep

# Stage 4 contains generated person-level/intermediate analysis data
data/interim/stage4/

# Stage 5 contains person-level / generated intermediate data only
data/interim/stage5/

# Stage 6 contains person-level imputations, residuals, and model matrices
data/interim/stage6/
artifacts/inference/**/*.rds
artifacts/inference/**/*patient*
artifacts/inference/**/*dfbeta*
artifacts/inference/**/*residual*.csv

# Processed datasets
data/processed/*
!data/processed/.gitkeep

# Derived R artifacts that may contain person-level data
artifacts/descriptive/**/*.rds

# Local YAML settings (keep the committed example)
config/settings.yaml

# R session artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj
Rplots.pdf

# Quarto / report artifacts
reports/**/*.html
reports/**/*.pdf
reports/**/*_files/
/_freeze/
*.quarto_ipynb